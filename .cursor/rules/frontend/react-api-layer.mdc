## File Upload Handling

```typescript
// hooks/useFileUpload.ts
interface UseFileUploadOptions {
  maxSize?: number; // in bytes
  allowedTypes?: string[];
  onProgress?: (progress: number) => void;
}

export const useFileUpload = (options: UseFileUploadOptions = {}) => {
  const [isUploading, setIsUploading] = useState(false);
  const [progress, setProgress] = useState(0);

  const upload = useCallback(async (file: File, uploadFn: (file: File) => Promise<any>) => {
    // Validate file
    if (options.maxSize && file.size > options.maxSize) {
      throw new Error(`File size must be less than ${options.maxSize} bytes`);
    }

    if (options.allowedTypes && !options.allowedTypes.includes(file.type)) {
      throw new Error(`File type ${file.type} is not allowed`);
    }

    setIsUploading(true);
    setProgress(0);

    try {
      const result = await uploadFn(file);
      setProgress(100);
      return result;
    } finally {
      setIsUploading(false);
      setProgress(0);
    }
  }, [options]);

  return { upload, isUploading, progress };
};

// Usage
export const UserAvatarUpload = ({ userId }: { userId: string }) => {
  const updateUser = useUpdateUser();
  const { upload, isUploading, progress } = useFileUpload({
    maxSize: 5 * 1024 * 1024, // 5MB
    allowedTypes: ['image/jpeg', 'image/png'],
  });

  const handleFileSelect = async (file: File) => {
    try {
      await upload(file, (file) => userApi.uploadAvatar(userId, file));
      // File uploaded successfully
    } catch (error) {
      // Handle upload error
    }
  };

  return (
    <div>
      <input
        type="file"
        accept="image/*"
        onChange={(e) => {
          const file = e.target.files?.[0];
          if (file) handleFileSelect(file);
        }}
        disabled={isUploading}
      />
      {isUploading && <ProgressBar progress={progress} />}
    </div>
  );
};
```
