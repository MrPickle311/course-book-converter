# React Performance Optimization Rules (Bulletproof React)

Based on [Bulletproof React](https://github.com/alan2207/bulletproof-react) performance best practices.

## Component Optimization

### 1. Memoization Strategies

#### React.memo for Component Memoization
```typescript
// ✅ Good - Memoize expensive components
interface UserCardProps {
  user: User;
  onEdit: (user: User) => void;
  onDelete: (userId: string) => void;
}

export const UserCard = memo(({ user, onEdit, onDelete }: UserCardProps) => {
  return (
    <div className="user-card">
      <img src={user.avatar} alt={user.name} />
      <h3>{user.name}</h3>
      <p>{user.email}</p>
      <button onClick={() => onEdit(user)}>Edit</button>
      <button onClick={() => onDelete(user.id)}>Delete</button>
    </div>
  );
});

// ✅ Good - Custom comparison for complex props
export const ExpensiveChart = memo(({ data, config }: ChartProps) => {
  // Expensive rendering logic
  return <Chart data={data} config={config} />;
}, (prevProps, nextProps) => {
  // Only re-render if data length or config changed
  return (
    prevProps.data.length === nextProps.data.length &&
    JSON.stringify(prevProps.config) === JSON.stringify(nextProps.config)
  );
});
```

#### useMemo for Expensive Calculations
```typescript
export const DataAnalytics = ({ data }: { data: DataPoint[] }) => {
  // ✅ Good - Memoize expensive calculations
  const analytics = useMemo(() => {
    return {
      average: data.reduce((sum, point) => sum + point.value, 0) / data.length,
      maximum: Math.max(...data.map(point => point.value)),
      minimum: Math.min(...data.map(point => point.value)),
      trend: calculateTrend(data), // Expensive calculation
    };
  }, [data]);

  // ✅ Good - Memoize filtered data
  const filteredData = useMemo(() =>
    data.filter(point => point.value > analytics.average),
    [data, analytics.average]
  );

  return (
    <div>
      <AnalyticsCard analytics={analytics} />
      <DataChart data={filteredData} />
    </div>
  );
};
```

#### useCallback for Function Memoization
```typescript
export const TodoList = ({ todos }: { todos: Todo[] }) => {
  const [filter, setFilter] = useState<'all' | 'active' | 'completed'>('all');

  // ✅ Good - Memoize event handlers
  const handleToggle = useCallback((todoId: string) => {
    // Toggle todo logic
  }, []);

  const handleDelete = useCallback((todoId: string) => {
    // Delete todo logic
  }, []);

  const handleFilterChange = useCallback((newFilter: typeof filter) => {
    setFilter(newFilter);
  }, []);

  // ✅ Good - Memoize filtered todos
  const filteredTodos = useMemo(() =>
    todos.filter(todo => {
      if (filter === 'active') return !todo.completed;
      if (filter === 'completed') return todo.completed;
      return true;
    }), [todos, filter]
  );

  return (
    <div>
      <FilterButtons onFilterChange={handleFilterChange} activeFilter={filter} />
      {filteredTodos.map(todo => (
        <TodoItem
          key={todo.id}
          todo={todo}
          onToggle={handleToggle}
          onDelete={handleDelete}
        />
      ))}
    </div>
  );
};
```

### 2. Code Splitting and Lazy Loading

#### Route-Based Code Splitting
```typescript
// ✅ Good - Lazy load route components
import { lazy, Suspense } from 'react';
import { Routes, Route } from 'react-router-dom';

const HomePage = lazy(() => import('@/pages/HomePage'));
const UserProfile = lazy(() => import('@/pages/UserProfile'));
const Dashboard = lazy(() => import('@/pages/Dashboard'));
const AdminPanel = lazy(() =>
  import('@/pages/AdminPanel').then(module => ({
    default: module.AdminPanel
  }))
);

export const AppRoutes = () => (
  <Suspense fallback={<PageLoadingSpinner />}>
    <Routes>
      <Route path="/" element={<HomePage />} />
      <Route path="/profile" element={<UserProfile />} />
      <Route path="/dashboard" element={<Dashboard />} />
      <Route path="/admin" element={<AdminPanel />} />
    </Routes>
  </Suspense>
);
```

#### Component-Based Code Splitting
```typescript
// ✅ Good - Lazy load heavy components
const HeavyChart = lazy(() => import('./HeavyChart'));
const DataTable = lazy(() => import('./DataTable'));
const ImageEditor = lazy(() => import('./ImageEditor'));

export const Dashboard = () => {
  const [activeTab, setActiveTab] = useState('overview');

  return (
    <div className="dashboard">
      <TabNavigation activeTab={activeTab} onTabChange={setActiveTab} />

      <Suspense fallback={<ComponentSkeleton />}>
        {activeTab === 'charts' && <HeavyChart />}
        {activeTab === 'data' && <DataTable />}
        {activeTab === 'editor' && <ImageEditor />}
      </Suspense>
    </div>
  );
};
```

#### Dynamic Imports for Conditional Loading
```typescript
// ✅ Good - Load components based on user permissions
export const ConditionalFeatures = ({ user }: { user: User }) => {
  const [AdminComponents, setAdminComponents] = useState<any>(null);

  useEffect(() => {
    if (user.role === 'admin') {
      import('@/features/admin').then(module => {
        setAdminComponents(module);
      });
    }
  }, [user.role]);

  return (
    <div>
      <UserFeatures />
      {user.role === 'admin' && AdminComponents && (
        <AdminComponents.AdminDashboard />
      )}
    </div>
  );
};
```

### 3. Virtual Scrolling for Large Lists

```typescript
// ✅ Good - Virtual scrolling for large datasets
import { FixedSizeList as List } from 'react-window';

interface VirtualizedListProps {
  items: any[];
  itemHeight: number;
  containerHeight: number;
}

const ListItem = memo(({ index, style, data }: {
  index: number;
  style: React.CSSProperties;
  data: any[];
}) => (
  <div style={style}>
    <ItemComponent item={data[index]} />
  </div>
));

export const VirtualizedList = ({
  items,
  itemHeight,
  containerHeight
}: VirtualizedListProps) => (
  <List
    height={containerHeight}
    itemCount={items.length}
    itemSize={itemHeight}
    itemData={items}
  >
    {ListItem}
  </List>
);

// Usage
export const UserList = () => {
  const { data: users } = useUsers();

  return (
    <VirtualizedList
      items={users || []}
      itemHeight={80}
      containerHeight={600}
    />
  );
};
```

### 4. Image Optimization

```typescript
// ✅ Good - Lazy loading images with placeholder
interface OptimizedImageProps {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  placeholder?: string;
  className?: string;
}

export const OptimizedImage = ({
  src,
  alt,
  width,
  height,
  placeholder = '/placeholder.jpg',
  className,
}: OptimizedImageProps) => {
  const [imageSrc, setImageSrc] = useState(placeholder);
  const [isLoading, setIsLoading] = useState(true);
  const imgRef = useRef<HTMLImageElement>(null);

  useEffect(() => {
    const img = imgRef.current;
    if (!img) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          const image = new Image();
          image.onload = () => {
            setImageSrc(src);
            setIsLoading(false);
          };
          image.src = src;
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );

    observer.observe(img);
    return () => observer.disconnect();
  }, [src]);

  return (
    <div className={cn('image-container', className)}>
      <img
        ref={imgRef}
        src={imageSrc}
        alt={alt}
        width={width}
        height={height}
        className={cn('optimized-image', { loading: isLoading })}
      />
      {isLoading && <div className="image-loading-overlay" />}
    </div>
  );
};
```

## Bundle Optimization

### 1. Tree Shaking and Dead Code Elimination

```typescript
// ✅ Good - Import only what you need
import { debounce } from 'lodash/debounce';
import { formatDate } from 'date-fns/formatDate';

// ❌ Avoid - Imports entire library
import _ from 'lodash';
import dateFns from 'date-fns';

// ✅ Good - Use babel-plugin-import for automatic tree shaking
import { Button, Input, Modal } from 'antd';
```

