### 3. Preloading Critical Resources

```typescript
// ✅ Good - Preload critical routes
export const HomePage = () => {
  useEffect(() => {
    // Preload likely next routes
    import('@/pages/UserProfile');
    import('@/pages/Dashboard');
  }, []);

  return <div>Home Page Content</div>;
};

// ✅ Good - Prefetch on hover
export const NavigationLink = ({ to, children }: { to: string; children: React.ReactNode }) => {
  const handleMouseEnter = () => {
    // Prefetch route component
    import(`@/pages${to}`);
  };

  return (
    <Link to={to} onMouseEnter={handleMouseEnter}>
      {children}
    </Link>
  );
};
```

## State and Rendering Optimization

### 1. Avoid Unnecessary Re-renders

```typescript
// ✅ Good - Split state to minimize re-renders
export const UserForm = () => {
  // Separate frequently changing state
  const [formData, setFormData] = useState({ name: '', email: '' });
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [errors, setErrors] = useState<Record<string, string>>({});

  // Use functional updates to avoid dependencies
  const updateField = useCallback((field: string) => (value: string) => {
    setFormData(prev => ({ ...prev, [field]: value }));
  }, []);

  return (
    <form>
      <Input
        value={formData.name}
        onChange={(e) => updateField('name')(e.target.value)}
        error={errors.name}
      />
      <Input
        value={formData.email}
        onChange={(e) => updateField('email')(e.target.value)}
        error={errors.email}
      />
      <SubmitButton isLoading={isSubmitting} />
    </form>
  );
};
```

### 2. Optimize Context Usage

```typescript
// ✅ Good - Split contexts by update frequency
interface UserContextType {
  user: User | null;
  updateUser: (user: User) => void;
}

interface UIContextType {
  theme: 'light' | 'dark';
  toggleTheme: () => void;
  sidebarOpen: boolean;
  setSidebarOpen: (open: boolean) => void;
}

// Separate contexts to prevent unnecessary re-renders
export const UserContext = createContext<UserContextType | null>(null);
export const UIContext = createContext<UIContextType | null>(null);

// ✅ Good - Memoize context values
export const UserProvider = ({ children }: { children: React.ReactNode }) => {
  const [user, setUser] = useState<User | null>(null);

  const updateUser = useCallback((newUser: User) => {
    setUser(newUser);
  }, []);

  const value = useMemo(() => ({ user, updateUser }), [user, updateUser]);

  return (
    <UserContext.Provider value={value}>
      {children}
    </UserContext.Provider>
  );
};
```

### 3. Debounce and Throttle User Interactions

```typescript
// Custom hook for debounced API calls
export const useDebouncedApi = <T>(
  apiCall: (query: string) => Promise<T>,
  delay: number = 300
) => {
  const [data, setData] = useState<T | null>(null);
  const [isLoading, setIsLoading] = useState(false);

  const debouncedApiCall = useMemo(
    () => debounce(async (query: string) => {
      setIsLoading(true);
      try {
        const result = await apiCall(query);
        setData(result);
      } finally {
        setIsLoading(false);
      }
    }, delay),
    [apiCall, delay]
  );

  return { data, isLoading, search: debouncedApiCall };
};

// Usage
export const SearchInput = () => {
  const [query, setQuery] = useState('');
  const { data: results, isLoading, search } = useDebouncedApi(searchApi, 300);

  useEffect(() => {
    if (query.length > 2) {
      search(query);
    }
  }, [query, search]);

  return (
    <div>
      <input
        type="text"
        value={query}
        onChange={(e) => setQuery(e.target.value)}
        placeholder="Search..."
      />
      {isLoading && <LoadingSpinner />}
      {results && <SearchResults results={results} />}
    </div>
  );
};
```

## Monitoring and Profiling

### 1. Performance Monitoring

```typescript
// ✅ Good - Custom performance hook
export const usePerformanceMonitor = (componentName: string) => {
  useEffect(() => {
    const startTime = performance.now();

    return () => {
      const endTime = performance.now();
      const renderTime = endTime - startTime;

      if (renderTime > 16) { // More than one frame
        console.warn(`${componentName} took ${renderTime.toFixed(2)}ms to render`);
      }
    };
  });
};

// Usage in components
export const ExpensiveComponent = () => {
  usePerformanceMonitor('ExpensiveComponent');

  // Component logic
  return <div>...</div>;
};
```

